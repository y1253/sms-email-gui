# Production overrides. Vite loads `.env` first, then this file for `npm run build`,
# and values here win — so dev keeps localhost and the production build no longer
# depends on whatever `.env` happens to be checked out on the server.
# VITE_STRIPE_PUBLIC_KEY and VITE_GOOGLE_CLIENT_ID are identical in both
# environments and keep coming from `.env`.
VITE_API_URL=https://emailontext.com
VITE_GOOGLE_REDIRECT_URI=https://emailontext.com/auth/google/callback
